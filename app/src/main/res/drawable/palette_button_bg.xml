<?xml version="1.0" encoding="utf-8"?>
<!-- Neutral ring behind the palette icon. Inset so the ring matches the
     color dots' size (radius = half button - 8dp), not the full button. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:inset="8dp">
    <shape android:shape="oval">
        <solid android:color="#00000000" />
        <stroke
            android:width="1.5dp"
            android:color="#669E9E9E" />
    </shape>
</inset>
