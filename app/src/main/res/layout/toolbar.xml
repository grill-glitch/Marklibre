<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:animateLayoutChanges="true"
    android:elevation="@dimen/toolbar_elevation"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <include layout="@layout/color_panel" />

    <FrameLayout
        android:id="@+id/tool_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/toolbar_sheet"
        android:paddingHorizontal="8dp">

        <!-- Moving bright highlight: slides (non-linear) from the old tool
             to the newly selected one; sits under the button icons. -->
        <View
            android:id="@+id/tool_highlight"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="left|center_vertical"
            android:background="@drawable/tool_button_highlight"
            android:importantForAccessibility="no"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/tool_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/crop_button"
                style="@style/MarkupToolbarButton"
                android:contentDescription="@string/crop"
                android:src="@drawable/ic_crop"
                android:tint="?attr/colorOnSurface"
                android:tooltipText="@string/crop" />

            <ImageButton
                android:id="@+id/ink_text_button"
                style="@style/MarkupToolbarButton"
                android:contentDescription="@string/ink_text"
                android:src="@drawable/ic_text"
                android:tint="?attr/colorOnSurface"
                android:tooltipText="@string/ink_text" />

            <org.librelab.marklibre.PenButton
                android:id="@+id/ink_pen_button"
                style="@style/MarkupToolbarButton"
                android:layout_gravity="center"
                android:contentDescription="@string/ink_pen"
                app:neutral_color="?attr/colorOnSurface"
                app:tool_name="@string/ink_pen"
                android:tooltipText="@string/ink_pen" />

            <org.librelab.marklibre.PenButton
                android:id="@+id/ink_highlighter_button"
                style="@style/MarkupToolbarButton"
                android:layout_gravity="center"
                android:contentDescription="@string/ink_highlighter"
                app:neutral_color="?attr/colorOnSurface"
                app:tool_name="@string/ink_highlighter"
                android:tooltipText="@string/ink_highlighter" />

            <ImageButton
                android:id="@+id/ink_eraser_button"
                style="@style/MarkupToolbarButton"
                android:contentDescription="@string/ink_eraser"
                android:src="@drawable/ic_eraser"
                android:tint="?attr/colorOnSurface"
                android:tooltipText="@string/ink_eraser" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
