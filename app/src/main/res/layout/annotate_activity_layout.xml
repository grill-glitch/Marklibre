<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/non_text_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurfaceContainer"
        android:orientation="vertical">

        <include layout="@layout/action_bar" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <org.librelab.marklibre.DrawingCanvasView
                android:id="@+id/drawing_canvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/ink_canvas_margin_bottom"
                android:contentDescription="@string/drawing_canvas" />

            <org.librelab.marklibre.CropOverlayView
                android:id="@+id/crop_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/crop_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="@dimen/ink_canvas_margin_bottom"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone">

                <!-- Crop mode no longer has a confirm button: switching to
                     any other tool, picking a color, rotating, or saving
                     implicitly commits the visible crop. The remaining
                     Cancel button sits in the blank strip below the image,
                     anchored with the same bottom inset as the canvas, so
                     it clears the (now always visible) bottom toolbar. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/crop_cancel"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/crop_cancel" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/toolbar_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <fragment
                    android:id="@+id/toolbar_fragment"
                    android:name="org.librelab.marklibre.ToolbarFragment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal" />
            </LinearLayout>

            <!-- Inline palette picker: floats ABOVE the toolbar (same window,
                 so taps on the toolbar/color dots/canvas pass straight
                 through). The panel is laid out bottom-aligned inside
                 palette_viewport, whose height is set in code to end just
                 above the toolbar. Clipping on the viewport - the panel's
                 parent - rather than on the panel means the slid-down part
                 is hidden AND not touchable, so a peeking panel can never
                 cover the toolbar or swallow taps meant for it. -->
            <FrameLayout
                android:id="@+id/palette_viewport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:clipChildren="true"
                android:clipToPadding="true">

                <LinearLayout
                    android:id="@+id/palette_panel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <include layout="@layout/palette_popup" />
                </LinearLayout>
            </FrameLayout>

            <!-- Drag-to-delete drop target: edge-to-edge sheet with rounded
                 top corners covering the screen bottom, shown while dragging
                 text (below the image, never over it). -->
            <ImageView
                android:id="@+id/trash_drop"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="bottom|center_horizontal"
                android:background="@drawable/trash_sheet"
                android:contentDescription="@string/delete"
                android:scaleType="center"
                android:src="@drawable/ic_delete"
                android:tint="?attr/colorOnPrimary"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <fragment
        android:id="@+id/text_fragment"
        android:name="org.librelab.marklibre.text.TextEditorFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33FFFFFF"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true" />
    </FrameLayout>
</FrameLayout>
