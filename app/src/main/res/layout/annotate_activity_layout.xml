<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/non_text_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurfaceContainer"
        android:orientation="vertical">

        <include layout="@layout/action_bar" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.google.android.markup.DrawingCanvasView
                android:id="@+id/drawing_canvas"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/ink_canvas_margin_bottom"
                android:contentDescription="@string/drawing_canvas" />

            <com.google.android.markup.CropOverlayView
                android:id="@+id/crop_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/crop_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="8dp"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/crop_cancel"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/crop_cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/crop_confirm"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/crop_confirm" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/toolbar_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:orientation="vertical">

                <fragment
                    android:id="@+id/toolbar_fragment"
                    android:name="com.google.android.markup.ToolbarFragment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal" />
            </LinearLayout>

            <!-- Drag-to-delete drop target: capsule covering the toolbar row,
                 shown while dragging text, below the image (never over it). -->
            <ImageView
                android:id="@+id/trash_drop"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/trash_pill"
                android:contentDescription="@string/delete"
                android:scaleType="center"
                android:src="@drawable/ic_delete"
                android:tint="?attr/colorOnPrimaryContainer"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <fragment
        android:id="@+id/text_fragment"
        android:name="com.google.android.markup.text.TextEditorFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33FFFFFF"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true" />
    </FrameLayout>
</FrameLayout>
