<?xml version="1.0" encoding="utf-8"?>
<!--
    Popup shell: rounded surface + elevation. The body is a single ComposeView
    that hosts the rest of the picker (swatches, hex, hue ring, sat/value
    square, alpha slider, action buttons). Existing palette_panel frame,
    size (300dp), gravity (bottom|center_horizontal), elevation, and background
    stay in XML so the popup position above the toolbar is unchanged.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:background="@drawable/palette_popup_bg"
    android:elevation="8dp"
    android:orientation="vertical">

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/palette_compose_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>