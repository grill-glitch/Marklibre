<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/color_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:layout_marginHorizontal="8dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/floating_toolbar_background"
    android:clickable="true"
    android:importantForAccessibility="no"
    android:orientation="vertical"
    android:padding="4dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <org.librelab.marklibre.ColorButton
            style="@style/InkColorButton"
            android:layout_weight="1"
            android:tooltipText="@string/ink_color_black"
            app:ink_color="@color/ink_swatch_black" />

        <org.librelab.marklibre.ColorButton
            style="@style/InkColorButton"
            android:layout_weight="1"
            android:tooltipText="@string/ink_color_red"
            app:ink_color="@color/ink_swatch_red" />

        <org.librelab.marklibre.ColorButton
            style="@style/InkColorButton"
            android:layout_weight="1"
            android:tooltipText="@string/ink_color_yellow"
            app:ink_color="@color/ink_swatch_yellow" />

        <org.librelab.marklibre.ColorButton
            style="@style/InkColorButton"
            android:layout_weight="1"
            android:tooltipText="@string/ink_color_green"
            app:ink_color="@color/ink_swatch_green" />

        <org.librelab.marklibre.ColorButton
            android:id="@+id/ink_blue"
            style="@style/InkColorButton"
            android:layout_weight="1"
            android:tooltipText="@string/ink_color_blue"
            app:ink_color="@color/ink_swatch_blue" />

        <org.librelab.marklibre.ColorButton
            style="@style/InkColorButton"
            android:layout_weight="1"
            android:tooltipText="@string/ink_color_purple"
            app:ink_color="@color/ink_swatch_purple" />

        <org.librelab.marklibre.ColorButton
            style="@style/InkColorButton"
            android:layout_weight="1"
            android:tooltipText="@string/ink_color_white"
            app:ink_color="@color/ink_swatch_white" />

        <ImageView
            android:id="@+id/palette_button"
            style="@style/InkColorButton"
            android:layout_height="match_parent"
            android:background="@drawable/palette_button_bg"
            android:contentDescription="@string/palette"
            android:scaleType="centerInside"
            android:src="@drawable/palette_24"
            android:tooltipText="@string/palette" />
    </LinearLayout>

    <!-- Pen stroke width: live preview bar + slider. Pen-only. -->
    <LinearLayout
        android:id="@+id/pen_width_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <View
            android:id="@+id/pen_width_preview"
            android:layout_width="40dp"
            android:layout_height="16dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/pen_width" />

        <SeekBar
            android:id="@+id/pen_width_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/pen_width"
            android:max="14" />
    </LinearLayout>
</LinearLayout>
